# Copie para .env (que está no .gitignore) e preencha. NUNCA commite o .env nem coloque chaves no código.
ANTHROPIC_API_KEY=
# Alternativa segura em contêiner (Docker secret): caminho de um arquivo que contém a chave
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
LEGNA_AI_MODEL=claude-sonnet-5-5
LEGNA_MAX_FILE_MB=200
LEGNA_MAX_ENTITIES=2000000
# Caminho do ODA File Converter (DWG). Opcional; ferramenta externa proprietária.
# ODA_FILE_CONVERTER=/opt/oda/ODAFileConverter
LEGNA_DWG_TIMEOUT=180
