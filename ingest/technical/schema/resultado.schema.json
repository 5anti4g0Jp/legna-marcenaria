     "type": "string"
    },
    "metodo": {
     "title": "Metodo",
     "type": "string"
    },
    "tipo": {
     "enum": [
      "leitura",
      "unidade",
      "geometria",
      "conflito_geometrico",
      "sem_medicao",
      "orientacao",
      "revisao_humana",
      "observacao"
     ],
     "title": "Tipo",
     "type": "string"
    }
   },
   "required": [
    "tipo",
    "descricao",
    "metodo"
   ],
   "title": "Evidencia",
   "type": "object"
  },
  "Medida": {
   "description": "Medida rastreável. IMUTÁVEL fora dos métodos de transição.\n\nO `estado` NÃO é um campo gravável: é sempre o destino da última transição do `histórico`. Histórico, evidências e\nconflitos são tuplas. Qualquer tentativa de escrever direto (ex.: `m.estado = ...`) levanta AttributeError, e as mudanças\nfeitas pelos métodos são revalidadas e REVERTIDAS se violarem um invariante.",
   "properties": {
    "analise_automatica": {
     "anyOf": [
      {
       "$ref": "#/$defs/AnaliseAutomatica"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "angulo_graus": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Angulo Graus"
    },
    "componente": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Componente"
    },
    "confianca": {
     "anyOf": [
      {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Confianca"
    },
    "conflitos": {
     "default": [],
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "title": "Conflitos",
     "type": "array"
    },
    "coords": {
     "maxItems": 4,
     "minItems": 4,
     "prefixItems": [
      {
       "type": "number"
      },
      {
       "type": "number"
      },
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "title": "Coords",
     "type": "array"
    },
    "documento": {
     "$ref": "#/$defs/Documento"
    },
    "estado": {
     "$ref": "#/$defs/Estado",
     "readOnly": true
    },
    "evidencias": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Evidencia"
     },
     "title": "Evidencias",
     "type": "array"
    },
    "historico": {
