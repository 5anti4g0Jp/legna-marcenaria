   "type": "string"
  },
  "Evidencia": {
   "description": "Prova auditável de uma conclusão. `dados` guarda os números usados (escala, intervalos, desvios...).",
   "properties": {
    "coords": {
     "anyOf": [
      {
       "maxItems": 4,
       "minItems": 4,
       "prefixItems": [
        {
         "type": "number"
        },
        {
         "type": "number"
        },
        {
         "type": "number"
        },
        {
         "type": "number"
        }
       ],
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Coords"
    },
    "dados": {
     "additionalProperties": true,
     "title": "Dados",
     "type": "object"
    },
    "descricao": {
